{
  "name": "voltix",
  "version": "1.0.0",
  "description": "Voltix - Plataformero 2D de alto voltaje con Phaser y Electron para Linux",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "npm run build && electron .",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.bacb14.voltix",
    "productName": "Voltix",
    "afterPack": "electron/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableArgs": [
        "--no-sandbox"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "phaser": "^3.80.0"
  }
}
